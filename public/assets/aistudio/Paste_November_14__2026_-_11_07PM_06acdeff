  let lastTime = performance.now();
  function mainLoop(now) {
    const dt = Math.min(0.05, (now - lastTime) / 1000);
    lastTime = now;

    updateGame(dt);
    renderGame();
    requestAnimationFrame(mainLoop);
  }

  // Boot
  SaveManager.load();
  resizeCanvas();
  renderHub();
  requestAnimationFrame(mainLoop);
})();
</script>
