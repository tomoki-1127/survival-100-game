<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>SURVIVAL 100 - v0.1</title>
  <style>
    :root {
      --bg-dark: #0d1018;
      --panel-bg: rgba(18, 23, 36, 0.94);
      --panel-border: #334155;
      --gold: #f5b942;
      --hp: #ef4444;
      --xp: #38bdf8;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --rarity-normal: #cbd5e1;
      --rarity-rare: #38bdf8;
      --rarity-epic: #c084fc;
      --rarity-legendary: #fbbf24;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: var(--bg-dark);
      color: var(--text);
      font-family: system-ui, -apple-system, "Hiragino Kaku Gothic ProN", "Yu Gothic", "Meiryo", sans-serif;
    }

    #app {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    /* Canvas */
    #gameCanvas {
      display: block;
      width: 100%;
      height: 100%;
      touch-action: none;
    }

    /* Screens & Overlays */
    .screen {
      position: absolute;
      inset: 0;
      display: none;
      flex-direction: column;
      z-index: 20;
    }
    .screen.active {
      display: flex;
    }

    /* Hub Screen */
    #hubScreen {
      background: radial-gradient(circle at 50% 20%, #1e293b 0%, #0b0f19 75%);
      padding: 16px;
      overflow-y: auto;
      align-items: center;
    }

    .hub-container {
      width: 100%;
      max-width: 920px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding-bottom: 24px;
    }

    .hub-header {
      text-align: center;
      padding: 14px 12px;
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95));
      border: 1px solid #475569;
      border-radius: 14px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    }

    .game-title {
      margin: 0;
      font-size: clamp(1.7rem, 5vw, 2.7rem);
      letter-spacing: 0.08em;
      color: var(--gold);
      text-shadow: 0 3px 12px rgba(245, 185, 66, 0.35);
    }

    .game-subtitle {
      margin: 4px 0 10px;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .hub-summary {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
    }

    .badge-stat {
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid #334155;
      border-radius: 999px;
      padding: 6px 14px;
      font-size: 0.9rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .hub-nav {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 10px;
    }

    .btn {
      border: 1px solid #475569;
      border-radius: 10px;
      background: #1e293b;
      color: var(--text);
      padding: 11px 14px;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.08s ease, background 0.15s ease, border-color 0.15s ease;
    }
    .btn:active { transform: scale(0.97); }
    .btn:hover { background: #273549; border-color: #64748b; }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; }

    .btn-primary {
      background: linear-gradient(135deg, #d97706, #b45309);
      border-color: #f59e0b;
      color: #fff;
      font-size: 1.05rem;
      box-shadow: 0 4px 16px rgba(217, 119, 6, 0.35);
    }
    .btn-primary:hover { background: linear-gradient(135deg, #f59e0b, #d97706); }

    .btn-success {
      background: linear-gradient(135deg, #16a34a, #15803d);
      border-color: #22c55e;
    }
    .btn-danger {
      background: linear-gradient(135deg, #dc2626, #991b1b);
      border-color: #ef4444;
    }

    .btn-sm {
      padding: 6px 10px;
      font-size: 0.82rem;
      border-radius: 8px;
    }

    .hub-panel {
      background: var(--panel-bg);
      border: 1px solid var(--panel-border);
      border-radius: 14px;
      padding: 14px;
      min-height: 280px;
    }

    /* HUD */
    #hudLayer {
      position: absolute;
      inset: 0;
      pointer-events: none;
      display: none;
      z-index: 10;
    }
    #hudLayer.active { display: block; }

    .hud-top {
      position: absolute;
      top: 10px;
      left: 10px;
      right: 10px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
    }

    .hud-box {
      pointer-events: auto;
      background: rgba(13, 16, 24, 0.78);
      backdrop-filter: blur(4px);
      border: 1px solid rgba(100, 116, 139, 0.45);
      border-radius: 10px;
      padding: 8px 10px;
    }

    .hud-left {
      min-width: 175px;
      max-width: 240px;
      flex: 1;
    }

    .hud-right {
      text-align: right;
      min-width: 145px;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
    }

    .bar-wrap {
      width: 100%;
      height: 12px;
      background: #1e293b;
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid #334155;
      margin: 4px 0;
      position: relative;
    }
    .bar-fill {
      height: 100%;
      width: 100%;
      transition: width 0.12s linear;
    }
    .bar-hp { background: linear-gradient(90deg, #dc2626, #f87171); }
    .bar-xp { background: linear-gradient(90deg, #0284c7, #38bdf8); }
    .bar-day { background: linear-gradient(90deg, #d97706, #fbbf24); }

    .hud-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.78rem;
      font-weight: 700;
    }

    /* Boss HP Bar */
    #bossBarContainer {
      position: absolute;
      top: 96px;
      left: 50%;
      transform: translateX(-50%);
      width: min(420px, 86vw);
      background: rgba(15, 23, 42, 0.88);
      border: 1px solid #ef4444;
      border-radius: 10px;
      padding: 6px 10px;
      display: none;
      text-align: center;
    }
    #bossBarContainer.active { display: block; }
    #bossNameLabel {
      font-size: 0.85rem;
      font-weight: 800;
      color: #fca5a5;
      margin-bottom: 3px;
    }

    /* Bottom Action Bar */
    .hud-bottom {
      position: absolute;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 8px;
      pointer-events: auto;
      z-index: 12;
    }

    .action-slot {
      background: rgba(15, 23, 42, 0.86);
      border: 1px solid #475569;
      border-radius: 12px;
      padding: 6px 10px;
      min-width: 78px;
      text-align: center;
      color: var(--text);
      cursor: pointer;
      position: relative;
      overflow: hidden;
      font-size: 0.75rem;
      font-weight: 700;
    }
    .action-slot:active { transform: scale(0.95); }
    .action-slot.disabled { opacity: 0.5; }
    .action-slot .icon { font-size: 1.25rem; display: block; line-height: 1.2; }
    .action-slot .sub { font-size: 0.68rem; color: var(--muted); display: block; }
    .cooldown-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.62);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
      font-weight: 800;
      color: #fff;
      pointer-events: none;
    }

    /* Virtual Joystick */
    #joystickArea {
      position: absolute;
      left: 16px;
      bottom: 20px;
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.06);
      border: 2px solid rgba(255, 255, 255, 0.16);
      pointer-events: auto;
      touch-action: none;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 11;
    }
    #joystickKnob {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: rgba(245, 185, 66, 0.65);
      border: 2px solid rgba(255, 255, 255, 0.8);
      transform: translate(0px, 0px);
      pointer-events: none;
    }

    @media (max-width: 680px) {
      .hud-bottom {
        left: auto;
        right: 12px;
        bottom: 22px;
        transform: none;
      }
      .action-slot {
        min-width: 64px;
        padding: 5px 7px;
      }
      #joystickArea {
        width: 108px;
        height: 108px;
        left: 12px;
        bottom: 16px;
      }
    }

    /* Modals */
    .modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(5, 8, 15, 0.78);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 14px;
      z-index: 40;
    }
    .modal-backdrop.active { display: flex; }

    .modal-card {
      width: 100%;
      max-width: 720px;
      max-height: 88vh;
      background: #141a29;
      border: 1px solid #475569;
      border-radius: 14px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.65);
    }

    .modal-header {
      padding: 12px 16px;
      background: #0f1522;
      border-bottom: 1px solid #334155;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .modal-header h2 {
      margin: 0;
      font-size: 1.1rem;
      color: var(--gold);
    }

    .modal-body {
      padding: 14px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* Cards & Grids */
    .grid-cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 10px;
    }

    .item-card {
      background: #1b2336;
      border: 1px solid #334155;
      border-radius: 10px;
      padding: 10px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 8px;
    }

    .item-title {
      font-weight: 800;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .item-meta {
      font-size: 0.78rem;
      color: var(--muted);
      line-height: 1.4;
    }

    .rarity-ノーマル { color: var(--rarity-normal); }
    .rarity-レア { color: var(--rarity-rare); }
    .rarity-エピック { color: var(--rarity-epic); }
    .rarity-レジェンダリー { color: var(--rarity-legendary); }

    .tag {
      font-size: 0.7rem;
      padding: 2px 6px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.14);
      white-space: nowrap;
    }

    /* Level Up Choices */
    .perk-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 10px;
    }

    .perk-card {
      background: linear-gradient(160deg, #1e293b, #141c2e);
      border: 2px solid #475569;
      border-radius: 12px;
      padding: 14px;
      cursor: pointer;
      text-align: left;
      color: var(--text);
      transition: transform 0.1s ease, border-color 0.15s ease;
    }
    .perk-card:hover {
      border-color: var(--gold);
      transform: translateY(-2px);
    }
    .perk-card h3 {
      margin: 0 0 6px;
      font-size: 1rem;
      color: var(--gold);
    }
    .perk-card p {
      margin: 0;
      font-size: 0.84rem;
      color: #cbd5e1;
      line-height: 1.4;
    }

    /* Tabs */
    .tab-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .tab-btn {
      padding: 6px 11px;
      border-radius: 8px;
      background: #1e293b;
      border: 1px solid #334155;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
    }
    .tab-btn.active {
      background: #334155;
      color: #fff;
      border-color: var(--gold);
    }

    /* Toast Banner */
    #toastContainer {
      position: absolute;
      top: 64px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 60;
      display: flex;
      flex-direction: column;
      gap: 6px;
      pointer-events: none;
      width: min(360px, 90vw);
    }
    .toast {
      background: rgba(15, 23, 42, 0.94);
      border: 1px solid var(--gold);
      border-radius: 10px;
      padding: 8px 14px;
      text-align: center;
      font-size: 0.86rem;
      font-weight: 700;
      color: #fff;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5);
      animation: fadeSlide 2.6s ease forwards;
    }
    @keyframes fadeSlide {
      0% { opacity: 0; transform: translateY(-10px); }
      12% { opacity: 1; transform: translateY(0); }
      82% { opacity: 1; transform: translateY(0); }
      100% { opacity: 0; transform: translateY(-8px); }
    }

    .stat-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 8px;
    }
    .stat-box {
      background: #1b2336;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 8px 10px;
      display: flex;
      justify-content: space-between;
      font-size: 0.86rem;
    }

    .slot-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 8px;
    }
    .slot-box {
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 8px;
      font-size: 0.8rem;
    }
    .slot-box strong { display: block; color: var(--muted); font-size: 0.72rem; margin-bottom: 2px; }
  </style>
</head>
<body>
<div id="app">
  <!-- Game Canvas -->
  <canvas id="gameCanvas"></canvas>

  <!-- In-Game HUD -->
  <div id="hudLayer">
    <div class="hud-top">
      <div class="hud-box hud-left">
        <div class="hud-row">
          <span id="hudLv">Lv.1</span>
          <span id="hudCoins" style="color: var(--gold);">🪙 0</span>
        </div>
        <div class="bar-wrap" style="height:14px;">
          <div id="hudHpBar" class="bar-fill bar-hp"></div>
        </div>
        <div class="hud-row" style="font-size:0.72rem;">
          <span>HP</span>
          <span id="hudHpText">100 / 100</span>
        </div>
        <div class="bar-wrap" style="height:8px; margin-top:5px;">
          <div id="hudXpBar" class="bar-fill bar-xp" style="width:0%;"></div>
        </div>
        <div class="hud-row" style="font-size:0.68rem; color: var(--muted);">
          <span>EXP</span>
          <span id="hudXpText">0 / 40</span>
        </div>
      </div>

      <div class="hud-box hud-right">
        <div style="font-weight:800; font-size:0.95rem; color: var(--gold);" id="hudDay">1日目</div>
        <div style="font-size:0.75rem; color: #cbd5e1;" id="hudArea">始まりの森</div>
        <div class="bar-wrap" style="height:6px; width:115px;">
          <div id="hudDayBar" class="bar-fill bar-day" style="width:0%;"></div>
        </div>
        <div style="font-size:0.72rem; color: var(--muted);" id="hudTime">00:00</div>
        <button class="btn btn-sm" id="btnOpenMenu" style="margin-top:2px;">☰ メニュー</button>
      </div>
    </div>

    <div id="bossBarContainer">
      <div id="bossNameLabel">BOSS</div>
      <div class="bar-wrap" style="height:12px;">
        <div id="bossHpBar" class="bar-fill bar-hp"></div>
      </div>
    </div>

    <!-- Virtual Joystick (Left) -->
    <div id="joystickArea">
      <div id="joystickKnob"></div>
    </div>

    <!-- Bottom Action Bar -->
    <div class="hud-bottom">
      <button class="action-slot" id="btnHudWeapon" title="装備確認">
        <span class="icon">⚔️</span>
        <span id="hudWeaponName">剣</span>
        <span class="sub">自動攻撃</span>
      </button>
      <button class="action-slot" id="btnUseSkill" title="スキル (Space / E)">
        <span class="icon">🌪️</span>
        <span>旋風斬り</span>
        <span class="sub">Space/E</span>
        <div class="cooldown-overlay" id="skillCooldownOverlay" style="display:none;">0s</div>
      </button>
      <button class="action-slot" id="btnUsePotion" title="回復薬 (Q / F)">
        <span class="icon">🧪</span>
        <span>回復薬</span>
        <span class="sub" id="hudPotionCount">残 2 (Q)</span>
      </button>
    </div>
  </div>

  <!-- Hub Screen -->
  <div id="hubScreen" class="screen active">
    <div class="hub-container">
      <div class="hub-header">
        <h1 class="game-title">SURVIVAL 100</h1>
        <p class="game-subtitle">見下ろし型2DファンタジーサバイバルRPG — 100日目の魔王討伐とその先へ</p>
        <div class="hub-summary">
          <div class="badge-stat">🪙 所持コイン: <span id="hubCoins" style="color:var(--gold);">0</span></div>
          <div class="badge-stat">🏆 最高到達日数: <span id="hubBestDay" style="color:#38bdf8;">0日</span></div>
          <div class="badge-stat">⚔️ 総合戦力目安: <span id="hubPower">0</span></div>
        </div>
      </div>

      <div class="hub-nav">
        <button class="btn btn-primary" id="btnStartAdventure">▶ 冒険開始 (1日目)</button>
        <button class="btn" id="btnHubTabShop">🛡 武器・防具ショップ</button>
        <button class="btn" id="btnHubTabUpgrade">✨ 恒久強化ショップ</button>
        <button class="btn" id="btnHubTabEquip">🎒 装備変更</button>
        <button class="btn" id="btnHubTabRecord">📖 記録・図鑑・実績</button>
      </div>

      <div class="hub-panel" id="hubPanelContent"></div>
    </div>
  </div>

  <!-- In-Game Menu Modal -->
  <div id="gameMenuModal" class="modal-backdrop">
    <div class="modal-card">
      <div class="modal-header">
        <h2>冒険メニュー</h2>
        <button class="btn btn-sm" id="btnCloseGameMenu">✕ 閉じる (再開)</button>
      </div>
      <div class="modal-body">
        <div class="tab-row" id="gameMenuTabs">
          <button class="tab-btn active" data-tab="stats">ステータス</button>
          <button class="tab-btn" data-tab="equip">装備変更</button>
          <button class="tab-btn" data-tab="shop">武器・防具ショップ</button>
          <button class="tab-btn" data-tab="bestiary">モンスター図鑑</button>
          <button class="tab-btn" data-tab="system">拠点へ戻る</button>
        </div>
        <div id="gameMenuContent"></div>
      </div>
    </div>
  </div>

  <!-- Level Up Modal -->
  <div id="levelUpModal" class="modal-backdrop">
    <div class="modal-card" style="max-width:660px;">
      <div class="modal-header">
        <h2 id="levelUpTitle">LEVEL UP! 強化を1つ選択</h2>
      </div>
      <div class="modal-body">
        <div class="perk-grid" id="levelUpChoices"></div>
      </div>
    </div>
  </div>

  <!-- Death / Result Modal -->
  <div id="deathModal" class="modal-backdrop">
    <div class="modal-card" style="max-width:480px;">
      <div class="modal-header">
        <h2 style="color:#f87171;">力尽きた……</h2>
      </div>
      <div class="modal-body" style="text-align:center;">
        <p style="margin:0; font-size:1.15rem; font-weight:800;">
          到達記録: <span id="deathReachedDay" style="color:var(--gold);">1日目</span>
        </p>
        <p style="margin:0; font-size:0.9rem; color:var(--muted);">
          最高到達日数: <span id="deathBestDay">1日目</span>
        </p>
        <div class="stat-box" style="justify-content:center; gap:14px;">
          <span>今回獲得コイン: <strong id="deathRunCoins" style="color:var(--gold);">0</strong></span>
          <span>所持コイン合計: <strong id="deathTotalCoins" style="color:var(--gold);">0</strong></span>
        </div>
        <p style="margin:0; font-size:0.82rem; color:#94a3b8;">
          レベルと冒険中の一時強化はリセットされますが、コイン・装備・恒久強化・図鑑・最高記録は引き継がれます。
        </p>
        <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:6px;">
          <button class="btn btn-primary" id="btnRetryFromDeath">▶ 1日目から再挑戦</button>
          <button class="btn" id="btnReturnHubFromDeath">🏠 拠点へ戻る</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Day 100 Clear Modal -->
  <div id="victoryModal" class="modal-backdrop">
    <div class="modal-card" style="max-width:500px;">
      <div class="modal-header">
        <h2>🎉 100日目ボス撃破！</h2>
      </div>
      <div class="modal-body" style="text-align:center;">
        <p style="margin:0; font-size:1.05rem; font-weight:700;">
          破滅の魔王ゼノスを討伐しました！
