  /* --- Spawning & Scaling --- */
  function getEnemyScaling(day) {
    const hpMult = 1 + (day - 1) * 0.16 + Math.pow(Math.max(0, day - 20), 1.32) * 0.025;
    const atkMult = 1 + (day - 1) * 0.10 + Math.max(0, day - 30) * 0.035;
    const rewardMult = 1 + (day - 1) * 0.08;
    return { hpMult, atkMult, rewardMult };
  }

  function spawnEnemy(typeId, customPos = null) {
    if (Game.enemies.length >= 110 && !MONSTERS_DB[typeId].isBoss) return;
    const def = MONSTERS_DB[typeId];
    const scale = getEnemyScaling(Game.day);

    let x, y;
    if (customPos) {
      x = customPos.x;
      y = customPos.y;
    } else {
      const angle = Math.random() * Math.PI * 2;
      const dist = Math.max(canvas.width, canvas.height) * 0.45 + 140;
      x = Math.max(40, Math.min(ARENA_SIZE - 40, Game.player.x + Math.cos(angle) * dist));
      y = Math.max(40, Math.min(ARENA_SIZE - 40, Game.player.y + Math.sin(angle) * dist));
    }

    const hp = Math.round(def.hp * scale.hpMult * (def.isBoss ? (1 + (Game.day / 100) * 0.5) : 1));
    const atk = Math.round(def.atk * scale.atkMult);
    const defStat = Math.round(def.def * (1 + (Game.day - 1) * 0.04));

    Game.enemies.push({
      id: typeId,
      name: def.isBoss && Game.day !== 100 ? `${Game.day}日目の守護者` : def.name,
      isBoss: !!def.isBoss,
      isFinalBoss: typeId === "boss_100",
      shoots: !!def.shoots,
      x, y,
      radius: def.radius,
      hp,
      maxHp: hp,
      atk,
      def: defStat,
      speed: def.speed + Math.min(45, Game.day * 0.4),
      xp: Math.round(def.xp * scale.rewardMult),
      coins: Math.round(def.coins * scale.rewardMult),
      color: def.color,
      attackRange: def.attackRange,
      atkCd: def.atkCd,
      atkTimer: 0.4,
      specialTimer: 3.0,
      telegraph: null,
      hitFlash: 0,
      bobPhase: Math.random() * 6
    });
  }

  function pickEnemyTypeForDay(day) {
    const pool = ["slime", "slime", "slime"];
    if (day >= 2) pool.push("goblin", "goblin");
    if (day >= 4) pool.push("skeleton", "skeleton");
    if (day >= 6 && Math.random() < Math.min(0.28, 0.08 + day * 0.004)) {
      return "elite_brute";
    }
    return pool[Math.floor(Math.random() * pool.length)];
  }

  /* --- Combat Actions --- */
  function spawnFloatingText(x, y, text, color = "#fff", size = 14) {
    if (Game.floatingTexts.length > 60) Game.floatingTexts.shift();
    Game.floatingTexts.push({ x, y, text, color, size, life: 0.75, maxLife: 0.75 });
  }

  function spawnParticles(x, y, color, count = 6) {
    if (Game.particles.length > 140) return;
    for (let i = 0; i < count; i++) {
      const a = Math.random() * Math.PI * 2;
      const spd = 40 + Math.random() * 110;
      Game.particles.push({
        x, y,
        vx: Math.cos(a) * spd,
        vy: Math.sin(a) * spd,
        r: 2 + Math.random() * 3,
        color,
        life: 0.35 + Math.random() * 0.25,
        maxLife: 0.6
      });
    }
  }

  function damageEnemy(enemy, rawDmg, knockAngle = null, knockForce = 65) {
    const actual = Math.max(1, Math.round(rawDmg - enemy.def * 0.45));
    enemy.hp -= actual;
    enemy.hitFlash = 0.12;
    spawnFloatingText(enemy.x + (Math.random() * 16 - 8), enemy.y - enemy.radius - 4, `${actual}`, "#fef08a", 14);

    if (knockAngle !== null && !enemy.isBoss) {
      enemy.x += Math.cos(knockAngle) * (knockForce * 0.12);
      enemy.y += Math.sin(knockAngle) * (knockForce * 0.12);
    }

    if (enemy.hp <= 0) {
      killEnemy(enemy);
      return true;
    }
    return false;
  }

  function killEnemy(enemy) {
    const p = Game.player;
    spawnParticles(enemy.x, enemy.y, enemy.color, enemy.isBoss ? 26 : 9);

    // 経験値・コイン獲得
    const coinMult = 1 + SaveManager.data.permUpgrades.coinBonus * 0.1;
    const gainedCoins = Math.max(1, Math.round(enemy.coins * coinMult));
    Game.runCoins += gainedCoins;
    SaveManager.data.coins += gainedCoins;
    SaveManager.data.stats.totalKills += 1;
    SaveManager.data.bestiary[enemy.id] = (SaveManager.data.bestiary[enemy.id] || 0) + 1;

    spawnFloatingText(enemy.x, enemy.y - 22, `+${gainedCoins}G`, "#fbbf24", 12);

    // 撃破時回復
    if (p.runBonus.lifeOnKill > 0) {
      p.hp = Math.min(p.maxHp, p.hp + p.runBonus.lifeOnKill);
    }

    // 経験値加算 & レベルアップ判定
    p.xp += enemy.xp;
    checkLevelUp();

    if (enemy.isFinalBoss) {
      SaveManager.data.stats.boss100Defeated = true;
      SaveManager.save();
      checkAchievements();
      onDayComplete(true);
    } else if (enemy.isBoss) {
      SaveManager.save();
      onDayComplete(false);
    }
  }

  function checkLevelUp() {
    const p = Game.player;
    if (p.xp >= p.nextXp) {
      p.xp -= p.nextXp;
      p.level += 1;
      p.nextXp = Math.round(p.nextXp * 1.28 + 18);
      showLevelUpModal();
    }
  }

  function performPlayerAutoAttack() {
    const p = Game.player;
    let nearest = null;
    let bestDist = Infinity;

    for (const e of Game.enemies) {
      if (e.hp <= 0) continue;
      const d = Math.hypot(e.x - p.x, e.y - p.y) - e.radius;
      if (d <= p.range && d < bestDist) {
        bestDist = d;
        nearest = e;
      }
    }

    if (!nearest) return false;

    const angle = Math.atan2(nearest.y - p.y, nearest.x - p.x);
    p.facingAngle = angle;

    const style = p.attackStyle;
    if (style === "arrow" || style === "magic") {
      Game.projectiles.push({
        fromPlayer: true,
        x: p.x + Math.cos(angle) * 16,
        y: p.y + Math.sin(angle) * 16,
        vx: Math.cos(angle) * (style === "arrow" ? 560 : 420),
        vy: Math.sin(angle) * (style === "arrow" ? 560 : 420),
        radius: style === "arrow" ? 5 : 9,
        dmg: p.atk,
        aoe: style === "magic" ? 56 : 0,
        color: style === "arrow" ? "#fef08a" : "#f472b6",
        life: 1.1
      });
    } else if (style === "spin") {
      // 全方位斧回転斬り
      Game.slashEffects.push({ x: p.x, y: p.y, angle, arc: Math.PI * 2, radius: p.range, color: "#fb923c", life: 0.2, maxLife: 0.2 });
      for (const e of [...Game.enemies]) {
        if (e.hp <= 0) continue;
        const d = Math.hypot(e.x - p.x, e.y - p.y) - e.radius;
        if (d <= p.range) {
          damageEnemy(e, p.atk * 1.05, Math.atan2(e.y - p.y, e.x - p.x), 80);
        }
      }
    } else if (style === "thrust") {
      // 槍突き（前方細長範囲）
      Game.slashEffects.push({ x: p.x, y: p.y, angle, arc: 0.48, radius: p.range, color: "#38bdf8", life: 0.16, maxLife: 0.16 });
      for (const e of [...Game.enemies]) {
        if (e.hp <= 0) continue;
        const dx = e.x - p.x;
        const dy = e.y - p.y;
        const d = Math.hypot(dx, dy) - e.radius;
        if (d <= p.range) {
          const diff = Math.abs(Math.atan2(Math.sin(Math.atan2(dy, dx) - angle), Math.cos(Math.atan2(dy, dx) - angle)));
          if (diff <= 0.45) {
            damageEnemy(e, p.atk * 1.08, angle, 90);
          }
        }
      }
    } else {
      // 剣・大剣（前方扇形スラッシュ）
      const arc = style === "cleave" ? 2.1 : 1.45;
      Game.slashEffects.push({
        x: p.x, y: p.y, angle, arc, radius: p.range,
        color: style === "cleave" ? "#f87171" : "#e2e8f0",
        life: 0.18, maxLife: 0.18
      });
      for (const e of [...Game.enemies]) {
        if (e.hp <= 0) continue;
        const dx = e.x - p.x;
        const dy = e.y - p.y;
        const d = Math.hypot(dx, dy) - e.radius;
        if (d <= p.range) {
          const diff = Math.abs(Math.atan2(Math.sin(Math.atan2(dy, dx) - angle), Math.cos(Math.atan2(dy, dx) - angle)));
          if (diff <= arc * 0.58) {
            damageEnemy(e, p.atk, Math.atan2(dy, dx), style === "cleave" ? 110 : 70);
          }
        }
      }
    }

    Game.enemies = Game.enemies.filter(e => e.hp > 0);
    return true;
  }

  function triggerActiveSkill() {
    if (Game.mode !== "playing" || Game.paused || Game.skillCooldown > 0) return;
    const p = Game.player;
    Game.skillCooldown = Game.skillMaxCd;
    const radius = Math.max(145, p.range * 1.35);
    Game.slashEffects.push({ x: p.x, y: p.y, angle: 0, arc: Math.PI * 2, radius, color: "#fbbf24", life: 0.3, maxLife: 0.3 });
    Game.screenShake = 0.16;

    for (const e of [...Game.enemies]) {
      if (e.hp <= 0) continue;
      const d = Math.hypot(e.x - p.x, e.y - p.y) - e.radius;
      if (d <= radius) {
        damageEnemy(e, p.atk * 2.1 + 12, Math.atan2(e.y - p.y, e.x - p.x), 180);
      }
    }
    Game.enemies = Game.enemies.filter(e => e.hp > 0);
    spawnFloatingText(p.x, p.y - 30, "旋風斬り！", "#fbbf24", 15);
  }

  function useRecoveryPotion() {
    if (Game.mode !== "playing" || Game.paused) return;
    if (Game.potionCharges <= 0 || Game.potionCd > 0) return;
    const p = Game.player;
    if (p.hp >= p.maxHp) {
      showToast("HPは満タンです");
      return;
    }
    Game.potionCharges -= 1;
    Game.potionCd = 2.0;
    const heal = Math.round(p.maxHp * 0.45);
    p.hp = Math.min(p.maxHp, p.hp + heal);
    spawnParticles(p.x, p.y, "#4ade80", 12);
    spawnFloatingText(p.x, p.y - 26, `+${heal} HP`, "#4ade80", 16);
    updateHud();
  }

  function damagePlayer(rawDmg) {
    const p = Game.player;
    const dmg = Math.max(1, Math.round(rawDmg - p.def * 0.65));
    p.hp -= dmg;
    p.hitFlash = 0.18;
    Game.screenShake = 0.12;
    spawnFloatingText(p.x, p.y - 24, `-${dmg}`, "#ef4444", 15);

    if (p.hp <= 0) {
      p.hp = 0;
      handlePlayerDeath();
    }
  }

  function handlePlayerDeath() {
    Game.paused = true;
    const reached = Game.day;
    if (reached > SaveManager.data.bestDay) {
      SaveManager.data.bestDay = reached;
    }
    SaveManager.save();
    checkAchievements();

    document.getElementById("deathReachedDay").textContent = `${reached}日目`;
    document.getElementById("deathBestDay").textContent = `${SaveManager.data.bestDay}日目`;
    document.getElementById("deathRunCoins").textContent = `${Game.runCoins}`;
    document.getElementById("deathTotalCoins").textContent = `${SaveManager.data.coins}`;
    document.getElementById("deathModal").classList.add("active");
  }

  function onDayComplete(isDay100BossClear) {
    const prevArea = getAreaForDay(Game.day);
    Game.day += 1;
    Game.dayTimer = 0;
    Game.bossSpawnedThisDay = false;

    if (Game.day > SaveManager.data.bestDay) {
      SaveManager.data.bestDay = Game.day;
    }

    // 日数経過で少し回復＆3日ごとに回復薬補充
    const p = Game.player;
    p.hp = Math.min(p.maxHp, p.hp + Math.round(p.maxHp * 0.12));
    if (Game.day % 3 === 0 && Game.potionCharges < Game.potionMaxCharges) {
      Game.potionCharges += 1;
      showToast("🧪 回復薬が1つ補充された！");
    }

    // 仲間は翌日HP全快で復活
    for (const c of Game.companions) {
      c.downed = false;
      c.hp = c.maxHp;
    }

    // 150日目以降 50日ごとの仲間救出フック
    if (Game.day >= 150 && (Game.day - 150) % 50 === 0) {
      const classKeys = Object.keys(COMPANION_CLASSES);
      const idx = Math.floor((Game.day - 150) / 50) % classKeys.length;
      const key = classKeys[idx];
      if (!SaveManager.data.unlockedCompanions.includes(key)) {
        SaveManager.data.unlockedCompanions.push(key);
        spawnSavedCompanions();
        showToast(`🤝 新たな仲間「${COMPANION_CLASSES[key].name}」を救出した！`);
      }
    }

    const nextArea = getAreaForDay(Game.day);
    if (nextArea.id !== prevArea.id) {
      showToast(`🗺 新エリア解放: ${nextArea.name}！`);
    }

    if (isDay100BossClear) {
      Game.paused = true;
      document.getElementById("victoryModal").classList.add("active");
    } else if (Game.day % 10 === 0) {
      showToast(`⚠️ ${Game.day}日目: ボスが出現する！`);
    }

    SaveManager.save();
    checkAchievements();
  }

  /* --- Main Update Loop --- */
  function updateGame(dt) {
    if (Game.mode !== "playing" || Game.paused) return;

    const p = Game.player;
    Game.elapsedTotal += dt;
    if (Game.skillCooldown > 0) Game.skillCooldown = Math.max(0, Game.skillCooldown - dt);
    if (Game.potionCd > 0) Game.potionCd = Math.max(0, Game.potionCd - dt);
    if (Game.screenShake > 0) Game.screenShake = Math.max(0, Game.screenShake - dt);
    if (p.hitFlash > 0) p.hitFlash = Math.max(0, p.hitFlash - dt);

    // 定期セーブ（コイン等の保護）
    Game.lastSaveTick += dt;
    if (Game.lastSaveTick >= 5) {
      Game.lastSaveTick = 0;
      SaveManager.save();
    }

    // 1. プレイヤー移動
    let mx = 0, my = 0;
    if (Input.keys["KeyW"] || Input.keys["ArrowUp"]) my -= 1;
    if (Input.keys["KeyS"] || Input.keys["ArrowDown"]) my += 1;
    if (Input.keys["KeyA"] || Input.keys["ArrowLeft"]) mx -= 1;
    if (Input.keys["KeyD"] || Input.keys["ArrowRight"]) mx += 1;
    if (Input.joyActive) {
      mx += Input.joyX;
      my += Input.joyY;
    }

    const len = Math.hypot(mx, my);
    if (len > 0.05) {
      const nx = mx / Math.max(1, len);
      const ny = my / Math.max(1, len);
      p.x += nx * p.moveSpeed * dt;
      p.y += ny * p.moveSpeed * dt;
      p.x = Math.max(32, Math.min(ARENA_SIZE - 32, p.x));
      p.y = Math.max(32, Math.min(ARENA_SIZE - 32, p.y));
      p.facingAngle = Math.atan2(ny, nx);
      p.walkPhase += dt * 11;
    }

    // 自動回復
    if (p.hp < p.maxHp && p.regen > 0) {
      p.hp = Math.min(p.maxHp, p.hp + p.regen * dt);
    }

    // プレイヤー自動攻撃
    p.atkTimer -= dt;
    if (p.atkTimer <= 0) {
      if (performPlayerAutoAttack()) {
        p.atkTimer = 1 / p.atkSpeed;
      } else {
        p.atkTimer = 0.05;
      }
    }

    // 2. 日数・スポーン進行
    const isBossDay = Game.day % 10 === 0;
    if (isBossDay) {
      if (!Game.bossSpawnedThisDay) {
        Game.bossSpawnedThisDay = true;
        spawnEnemy(Game.day === 100 ? "boss_100" : "boss_mid");
      }
      // ボス戦中の取り巻き控えめ湧き
      Game.spawnTimer -= dt;
      if (Game.spawnTimer <= 0 && Game.enemies.length < 12) {
        spawnEnemy(pickEnemyTypeForDay(Game.day));
        Game.spawnTimer = 2.6;
      }
    } else {
      Game.dayTimer += dt;
      if (Game.dayTimer >= DAY_DURATION) {
        onDayComplete(false);
      }
      Game.spawnTimer -= dt;
      if (Game.spawnTimer <= 0) {
        const batch = Math.min(4, 1 + Math.floor(Game.day / 8));
        for (let i = 0; i < batch; i++) {
          spawnEnemy(pickEnemyTypeForDay(Game.day));
        }
        Game.spawnTimer = Math.max(0.55, 1.85 - Game.day * 0.025);
      }
    }

    // 3. 仲間AI更新 (150日目以降の拡張対応)
    for (const c of Game.companions) {
      if (c.downed) continue;
      if (c.hitFlash > 0) c.hitFlash -= dt;
      c.atkTimer -= dt;

      if (c.role === "僧侶") {
        // プレイヤーに追従しつつ定期回復
        const distP = Math.hypot(p.x - c.x, p.y - c.y);
        if (distP > 75) {
          const a = Math.atan2(p.y - c.y, p.x - c.x);
          c.x += Math.cos(a) * c.speed * dt;
          c.y += Math.sin(a) * c.speed * dt;
        }
        if (c.atkTimer <= 0 && p.hp < p.maxHp) {
          c.atkTimer = c.cd;
          const heal = Math.round(p.maxHp * 0.08 + 12);
          p.hp = Math.min(p.maxHp, p.hp + heal);
          spawnFloatingText(p.x, p.y - 24, `+${heal}`, "#f472b6", 13);
        }
      } else {
        // 最寄りの敵を索敵
        let target = null;
        let best = Infinity;
        for (const e of Game.enemies) {
          const d = Math.hypot(e.x - c.x, e.y - c.y);
          if (d < best) { best = d; target = e; }
        }
        if (target && best > c.range * 0.85) {
          const a = Math.atan2(target.y - c.y, target.x - c.x);
          c.x += Math.cos(a) * c.speed * dt;
          c.y += Math.sin(a) * c.speed * dt;
        } else if (!target) {
          const distP = Math.hypot(p.x - c.x, p.y - c.y);
          if (distP > 85) {
            const a = Math.atan2(p.y - c.y, p.x - c.x);
            c.x += Math.cos(a) * c.speed * dt;
            c.y += Math.sin(a) * c.speed * dt;
          }
        }
        if (target && best <= c.range + target.radius && c.atkTimer <= 0) {
          c.atkTimer = c.cd;
          const a = Math.atan2(target.y - c.y, target.x - c.x);
          if (c.role === "弓使い" || c.role === "魔法使い") {
            Game.projectiles.push({
              fromPlayer: true, x: c.x, y: c.y,
              vx: Math.cos(a) * 440, vy: Math.sin(a) * 440,
              radius: 6, dmg: c.atk, aoe: c.role === "魔法使い" ? 48 : 0,
              color: c.color, life: 1.0
            });
          } else {
            damageEnemy(target, c.atk, a, 50);
          }
        }
      }
    }

    // 4. モンスターAI・戦闘更新
    for (const e of Game.enemies) {
      if (e.hp <= 0) continue;
      if (e.hitFlash > 0) e.hitFlash -= dt;
      e.bobPhase += dt * 7;

      // ターゲット決定（騎士仲間がいれば近い場合に引きつけ）
      let targetObj = p;
      let targetIsCompanion = false;
      for (const c of Game.companions) {
        if (!c.downed && c.role === "騎士") {
          const dC = Math.hypot(c.x - e.x, c.y - e.y);
          const dP = Math.hypot(p.x - e.x, p.y - e.y);
          if (dC < dP && dC < 240) {
            targetObj = c;
            targetIsCompanion = true;
          }
        }
      }

      const dx = targetObj.x - e.x;
      const dy = targetObj.y - e.y;
      const dist = Math.hypot(dx, dy) || 1;
      const nx = dx / dist;
      const ny = dy / dist;

      // ボス・強敵の特殊攻撃
      if (e.isBoss) {
        e.specialTimer -= dt;
        if (e.telegraph) {
          e.telegraph.timer -= dt;
          if (e.telegraph.timer <= 0) {
            // 範囲着弾
            const td = Math.hypot(p.x - e.telegraph.x, p.y - e.telegraph.y);
            if (td <= e.telegraph.radius + p.radius) {
              damagePlayer(e.atk * 1.45);
            }
            spawnParticles(e.telegraph.x, e.telegraph.y, "#ef4444", 16);
            e.telegraph = null;
          }
        } else if (e.specialTimer <= 0) {
          e.specialTimer = e.isFinalBoss ? 2.8 : 3.8;
          // 予兆円 + 全方位弾
          e.telegraph = { x: p.x, y: p.y, radius: 68, timer: 0.95, maxTimer: 0.95 };
          const count = e.isFinalBoss ? 10 : 6;
          for (let i = 0; i < count; i++) {
            const a = (Math.PI * 2 * i) / count;
            Game.projectiles.push({
              fromPlayer: false, x: e.x, y: e.y,
              vx: Math.cos(a) * 210, vy: Math.sin(a) * 210,
              radius: 7, dmg: e.atk * 0.9, aoe: 0, color: "#f43f5e", life: 2.0
            });
          }
        }
      }

      // 移動と攻撃
      const stopDist = e.shoots ? e.attackRange * 0.8 : e.radius + targetObj.radius - 2;
      if (dist > stopDist) {
        e.x += nx * e.speed * dt;
        e.y += ny * e.speed * dt;
      }

      e.atkTimer -= dt;
      if (dist <= e.attackRange + targetObj.radius && e.atkTimer <= 0) {
        e.atkTimer = e.atkCd;
        if (e.shoots && dist > e.radius + targetObj.radius + 15) {
          Game.projectiles.push({
            fromPlayer: false, x: e.x, y: e.y,
            vx: nx * 240, vy: ny * 240,
            radius: 6, dmg: e.atk, aoe: 0, color: "#c084fc", life: 1.8
          });
        } else if (dist <= e.radius + targetObj.radius + 14) {
          if (targetIsCompanion) {
            targetObj.hp -= Math.max(1, Math.round(e.atk - targetObj.def));
            targetObj.hitFlash = 0.14;
            if (targetObj.hp <= 0) {
              targetObj.hp = 0;
              targetObj.downed = true;
              showToast(`⚠️ ${targetObj.name}が戦闘離脱（翌日復活）`);
            }
          } else {
            damagePlayer(e.atk);
          }
        }
      }
    }

    // 敵同士の軽い押し出し（重なり防止）
    const eCount = Game.enemies.length;
    for (let i = 0; i < eCount; i++) {
      const a = Game.enemies[i];
      for (let j = i + 1; j < eCount; j++) {
        const b = Game.enemies[j];
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const minD = a.radius + b.radius;
        const d2 = dx * dx + dy * dy;
        if (d2 > 0 && d2 < minD * minD) {
          const d = Math.sqrt(d2);
          const push = (minD - d) * 0.35;
          const px = (dx / d) * push;
          const py = (dy / d) * push;
          if (!a.isBoss) { a.x -= px; a.y -= py; }
          if (!b.isBoss) { b.x += px; b.y += py; }
        }
      }
    }

    // 5. 飛び道具更新
    for (const proj of Game.projectiles) {
      proj.x += proj.vx * dt;
      proj.y += proj.vy * dt;
      proj.life -= dt;
      if (proj.life <= 0) continue;

      if (proj.fromPlayer) {
        for (const e of Game.enemies) {
          if (e.hp <= 0) continue;
          if (Math.hypot(e.x - proj.x, e.y - proj.y) <= e.radius + proj.radius) {
            if (proj.aoe > 0) {
              spawnParticles(proj.x, proj.y, proj.color, 10);
              for (const sub of [...Game.enemies]) {
                if (sub.hp > 0 && Math.hypot(sub.x - proj.x, sub.y - proj.y) <= proj.aoe + sub.radius) {
                  damageEnemy(sub, proj.dmg, Math.atan2(sub.y - proj.y, sub.x - proj.x), 55);
                }
              }
            } else {
              damageEnemy(e, proj.dmg, Math.atan2(proj.vy, proj.vx), 45);
            }
            proj.life = 0;
            break;
          }
        }
      } else {
        if (Math.hypot(p.x - proj.x, p.y - proj.y) <= p.radius + proj.radius) {
          damagePlayer(proj.dmg);
          proj.life = 0;
        }
      }
    }
    Game.projectiles = Game.projectiles.filter(pr => pr.life > 0);
    Game.enemies = Game.enemies.filter(e => e.hp > 0);

    // 6. エフェクト更新
    for (const s of Game.slashEffects) s.life -= dt;
    Game.slashEffects = Game.slashEffects.filter(s => s.life > 0);

    for (const pt of Game.particles) {
      pt.x += pt.vx * dt;
      pt.y += pt.vy * dt;
      pt.life -= dt;
    }
    Game.particles = Game.particles.filter(pt => pt.life > 0);

    for (const ft of Game.floatingTexts) {
      ft.y -= 32 * dt;
      ft.life -= dt;
    }
    Game.floatingTexts = Game.floatingTexts.filter(ft => ft.life > 0);

    // カメラ追従
    Game.camera.x += (p.x - Game.camera.x) * Math.min(1, dt * 10);
    Game.camera.y += (p.y - Game.camera.y) * Math.min(1, dt * 10);

    updateHud();
  }

  /* --- Canvas Rendering --- */
  function renderGame() {
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    if (Game.mode !== "playing" || !Game.player) {
      // 拠点背景の待機描画
      ctx.fillStyle = "#0b0f19";
      ctx.fillRect(0, 0, w, h);
      return;
    }

    const area = getAreaForDay(Game.day);
    const shakeX = Game.screenShake > 0 ? (Math.random() - 0.5) * 9 : 0;
    const shakeY = Game.screenShake > 0 ? (Math.random() - 0.5) * 9 : 0;
    const camX = Game.camera.x - w / 2 + shakeX;
    const camY = Game.camera.y - h / 2 + shakeY;

    // 背景とタイル
    ctx.fillStyle = area.bg;
    ctx.fillRect(0, 0, w, h);

    ctx.save();
    ctx.translate(-camX, -camY);

    const tileSize = 96;
    const startX = Math.max(0, Math.floor(camX / tileSize) * tileSize);
    const endX = Math.min(ARENA_SIZE, camX + w + tileSize);
    const startY = Math.max(0, Math.floor(camY / tileSize) * tileSize);
    const endY = Math.min(ARENA_SIZE, camY + h + tileSize);

    ctx.strokeStyle = area.tile;
    ctx.lineWidth = 2;
    for (let tx = startX; tx <= endX; tx += tileSize) {
      ctx.beginPath();
      ctx.moveTo(tx, startY);
      ctx.lineTo(tx, endY);
      ctx.stroke();
    }
    for (let ty = startY; ty <= endY; ty += tileSize) {
      ctx.beginPath();
      ctx.moveTo(startX, ty);
      ctx.lineTo(endX, ty);
      ctx.stroke();
    }

    // 地面プロップ（草・結晶・岩など）
    for (const gp of Game.groundProps) {
      if (gp.x < camX - 40 || gp.x > camX + w + 40 || gp.y < camY - 40 || gp.y > camY + h + 40) continue;
      ctx.fillStyle = gp.kind === 0 ? area.accent : (gp.kind === 1 ? area.tile : area.particle + "33");
      ctx.beginPath();
      ctx.arc(gp.x, gp.y, gp.size * 0.5, 0, Math.PI * 2);
      ctx.fill();
    }

    // アリーナ境界線
    ctx.strokeStyle = "#ef444488";
    ctx.lineWidth = 6;
    ctx.strokeRect(16, 16, ARENA_SIZE - 32, ARENA_SIZE - 32);

    // プレイヤー攻撃範囲の薄リング
    const p = Game.player;
    ctx.strokeStyle = "rgba(255, 255, 255, 0.08)";
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.range, 0, Math.PI * 2);
    ctx.stroke();

    // ボスの範囲攻撃予兆
    for (const e of Game.enemies) {
      if (e.telegraph) {
        const prog = 1 - e.telegraph.timer / e.telegraph.maxTimer;
        ctx.fillStyle = "rgba(239, 68, 68, 0.22)";
        ctx.beginPath();
        ctx.arc(e.telegraph.x, e.telegraph.y, e.telegraph.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#ef4444";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(e.telegraph.x, e.telegraph.y, e.telegraph.radius * prog, 0, Math.PI * 2);
        ctx.stroke();
      }
    }

    // 斬撃エフェクト
    for (const s of Game.slashEffects) {
      const alpha = s.life / s.maxLife;
      ctx.save();
      ctx.globalAlpha = alpha * 0.75;
      ctx.fillStyle = s.color;
      ctx.beginPath();
      if (s.arc >= Math.PI * 1.99) {
        ctx.arc(s.x, s.y, s.radius, 0, Math.PI * 2);
      } else {
        ctx.moveTo(s.x, s.y);
        ctx.arc(s.x, s.y, s.radius, s.angle - s.arc / 2, s.angle + s.arc / 2);
        ctx.closePath();
      }
      ctx.fill();
      ctx.restore();
    }

    // 仲間描画
    for (const c of Game.companions) {
      if (c.downed) continue;
      drawCharacterSprite(c.x, c.y, 14, c.hitFlash > 0 ? "#fff" : c.color, "#0f172a", c.role[0]);
      drawSmallHpBar(c.x, c.y - 22, 28, c.hp / c.maxHp, "#38bdf8");
    }

    // モンスター描画（固有ビジュアル）
    for (const e of Game.enemies) {
      if (e.x < camX - 80 || e.x > camX + w + 80 || e.y < camY - 80 || e.y > camY + h + 80) continue;
      drawMonsterSprite(e);
    }

    // プレイヤー描画
    drawPlayerSprite(p);

    // 飛び道具描画
    for (const pr of Game.projectiles) {
      ctx.fillStyle = pr.color;
      ctx.beginPath();
      ctx.arc(pr.x, pr.y, pr.radius, 0, Math.PI * 2);
      ctx.fill();
    }

    // パーティクル
    for (const pt of Game.particles) {
      ctx.globalAlpha = Math.max(0, pt.life / pt.maxLife);
      ctx.fillStyle = pt.color;
      ctx.beginPath();
      ctx.arc(pt.x, pt.y, pt.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;

    // ダメージ・コインテキスト
    ctx.textAlign = "center";
    for (const ft of Game.floatingTexts) {
      ctx.globalAlpha = Math.min(1, ft.life / 0.35);
      ctx.font = `800 ${ft.size}px system-ui, sans-serif`;
      ctx.fillStyle = "#000";
      ctx.fillText(ft.text, ft.x + 1, ft.y + 1);
      ctx.fillStyle = ft.color;
      ctx.fillText(ft.text, ft.x, ft.y);
    }
    ctx.globalAlpha = 1;

    ctx.restore();
  }

  function drawSmallHpBar(x, y, w, ratio, color = "#ef4444") {
    ctx.fillStyle = "rgba(0,0,0,0.65)";
    ctx.fillRect(x - w / 2, y, w, 4);
    ctx.fillStyle = color;
    ctx.fillRect(x - w / 2, y, w * Math.max(0, Math.min(1, ratio)), 4);
  }

  function drawCharacterSprite(x, y, r, bodyColor, trimColor, label) {
    ctx.fillStyle = "rgba(0,0,0,0.32)";
    ctx.beginPath();
    ctx.ellipse(x, y + r * 0.85, r * 0.9, r * 0.4, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = bodyColor;
    ctx.strokeStyle = trimColor;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    ctx.fillStyle = "#fff";
    ctx.font = "bold 10px sans-serif";
    ctx.textAlign = "center";
    ctx.fillText(label, x, y + 3.5);
  }

  function drawPlayerSprite(p) {
    const bob = Math.sin(p.walkPhase) * 2;
    // 影
    ctx.fillStyle = "rgba(0,0,0,0.38)";
    ctx.beginPath();
    ctx.ellipse(p.x, p.y + 15, 15, 7, 0, 0, Math.PI * 2);
    ctx.fill();

    // マント
    ctx.fillStyle = p.hitFlash > 0 ? "#fff" : "#dc2626";
    ctx.beginPath();
    ctx.arc(p.x - Math.cos(p.facingAngle) * 4, p.y - Math.sin(p.facingAngle) * 4 + bob, 15, 0, Math.PI * 2);
    ctx.fill();

    // 胴体・兜
    ctx.fillStyle = p.hitFlash > 0 ? "#fff" : "#38bdf8";
    ctx.strokeStyle = "#0f172a";
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.arc(p.x, p.y + bob, p.radius - 2, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    // 目の向き
    const ex = p.x + Math.cos(p.facingAngle) * 6;
    const ey = p.y + Math.sin(p.facingAngle) * 6 + bob;
    ctx.fillStyle = "#fde68a";
    ctx.beginPath();
    ctx.arc(ex, ey, 4.5, 0, Math.PI * 2);
    ctx.fill();

    // 武器ビジュアル
    const wx = p.x + Math.cos(p.facingAngle) * 18;
    const wy = p.y + Math.sin(p.facingAngle) * 18 + bob;
    ctx.strokeStyle = "#f8fafc";
    ctx.lineWidth = 3.5;
    ctx.beginPath();
    ctx.moveTo(p.x + Math.cos(p.facingAngle) * 10, p.y + Math.sin(p.facingAngle) * 10 + bob);
    ctx.lineTo(wx + Math.cos(p.facingAngle) * 10, wy + Math.sin(p.facingAngle) * 10);
    ctx.stroke();
  }

  function drawMonsterSprite(e) {
    const bob = Math.sin(e.bobPhase) * 2.5;
    const flash = e.hitFlash > 0;
    const r = e.radius;

    // 影
    ctx.fillStyle = "rgba(0,0,0,0.35)";
    ctx.beginPath();
    ctx.ellipse(e.x, e.y + r * 0.85, r * 0.95, r * 0.42, 0, 0, Math.PI * 2);
    ctx.fill();

    if (e.id === "slime") {
      // スライム：ぷるっとした半円ゼリー
      ctx.fillStyle = flash ? "#fff" : e.color;
      ctx.strokeStyle = "#14532d";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.ellipse(e.x, e.y + 3 + bob * 0.6, r, r * 0.82, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      // 目
      ctx.fillStyle = "#0f172a";
      ctx.fillRect(e.x - 6, e.y - 1 + bob * 0.6, 3, 4);
      ctx.fillRect(e.x + 3, e.y - 1 + bob * 0.6, 3, 4);
    } else if (e.id === "goblin") {
      // ゴブリン：尖った耳と赤い目
      ctx.fillStyle = flash ? "#fff" : e.color;
      ctx.strokeStyle = "#1a2e05";
      ctx.lineWidth = 2;
      // 耳
      ctx.beginPath();
      ctx.moveTo(e.x - r, e.y - 4 + bob);
      ctx.lineTo(e.x - r - 7, e.y - 10 + bob);
      ctx.lineTo(e.x - r + 4, e.y + 3 + bob);
      ctx.fill();
      ctx.beginPath();
      ctx.moveTo(e.x + r, e.y - 4 + bob);
      ctx.lineTo(e.x + r + 7, e.y - 10 + bob);
      ctx.lineTo(e.x + r - 4, e.y + 3 + bob);
      ctx.fill();
      // 体
      ctx.beginPath();
      ctx.arc(e.x, e.y + bob, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = "#ef4444";
      ctx.fillRect(e.x - 6, e.y - 3 + bob, 4, 3);
      ctx.fillRect(e.x + 2, e.y - 3 + bob, 4, 3);
    } else if (e.id === "skeleton") {
      // スケルトン：頭蓋骨＋盾輪郭
      ctx.fillStyle = flash ? "#fff" : "#f1f5f9";
      ctx.strokeStyle = "#334155";
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.arc(e.x, e.y + bob * 0.5, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = "#0f172a";
      ctx.beginPath();
      ctx.arc(e.x - 5, e.y - 2 + bob * 0.5, 3.2, 0, Math.PI * 2);
      ctx.arc(e.x + 5, e.y - 2 + bob * 0.5, 3.2, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillRect(e.x - 5, e.y + 6 + bob * 0.5, 10, 3);
    } else {
      // 強敵 / ボス：角付き装甲シルエット
      ctx.fillStyle = flash ? "#fff" : e.color;
      ctx.strokeStyle = e.isBoss ? "#fde047" : "#3b0764";
      ctx.lineWidth = e.isBoss ? 3.5 : 2.5;
      // 角
      ctx.beginPath();
      ctx.moveTo(e.x - r * 0.6, e.y - r * 0.5);
      ctx.lineTo(e.x - r * 0.95, e.y - r * 1.25);
      ctx.lineTo(e.x - r * 0.15, e.y - r * 0.85);
      ctx.fill();
      ctx.beginPath();
      ctx.moveTo(e.x + r * 0.6, e.y - r * 0.5);
      ctx.lineTo(e.x + r * 0.95, e.y - r * 1.25);
      ctx.lineTo(e.x + r * 0.15, e.y - r * 0.85);
      ctx.fill();

      ctx.beginPath();
      ctx.arc(e.x, e.y + bob * 0.4, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = "#fef08a";
      ctx.beginPath();
      ctx.arc(e.x - r * 0.3, e.y - 3, r * 0.15, 0, Math.PI * 2);
      ctx.arc(e.x + r * 0.3, e.y - 3, r * 0.15, 0, Math.PI * 2);
      ctx.fill();
    }

    if (!e.isBoss && e.hp < e.maxHp) {
      drawSmallHpBar(e.x, e.y - r - 9, r * 2, e.hp / e.maxHp);
    }
  }

