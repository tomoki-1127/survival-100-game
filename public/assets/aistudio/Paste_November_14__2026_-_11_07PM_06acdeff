    const total = { atk: 0, maxHp: 0, def: 0, atkSpeed: 0, moveSpeed: 0, regen: 0 };
    for (const slot of Object.keys(SaveManager.data.equipped)) {
      const id = SaveManager.data.equipped[slot];
      const item = getEquipmentById(id);
      if (item && item.stats) {
        for (const k of Object.keys(total)) {
          if (item.stats[k]) total[k] += item.stats[k];
        }
      }
    }
    return total;
  }

  function getBaseHubStats() {
    const perm = SaveManager.data.permUpgrades;
    const eq = getEquippedStats();
    return {
      maxHp: Math.round(100 + perm.maxHp * 18 + eq.maxHp),
      atk: Math.round(14 + perm.atk * 3 + eq.atk),
      def: Number((2 + perm.def * 1.5 + eq.def).toFixed(1)),
      atkSpeed: Number((1.25 + perm.atkSpeed * 0.08 + eq.atkSpeed).toFixed(2)),
      moveSpeed: Math.round(180 + perm.moveSpeed * 8 + eq.moveSpeed),
      regen: Number((0.4 + eq.regen).toFixed(1)),
      coinMult: 1 + perm.coinBonus * 0.1
    };
  }

  function getAreaForDay(day) {
    let current = AREAS_DB[0];
    for (const area of AREAS_DB) {
      if (day >= area.minDay) current = area;
    }
    return current;
  }

  function showToast(msg) {
    const container = document.getElementById("toastContainer");
    const el = document.createElement("div");
    el.className = "toast";
    el.textContent = msg;
    container.appendChild(el);
    setTimeout(() => el.remove(), 2700);
  }

  function checkAchievements() {
    let unlockedNow = false;
    for (const ach of ACHIEVEMENTS_DB) {
      if (!SaveManager.data.achievements.includes(ach.id) && ach.check(SaveManager.data)) {
        SaveManager.data.achievements.push(ach.id);
        showToast(`🏅 実績解除: ${ach.name}`);
        unlockedNow = true;
      }
    }
    if (unlockedNow) SaveManager.save();
  }

  function drawRoundedRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  }

