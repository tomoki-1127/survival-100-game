      achievements: [],
      unlockedCompanions: [],
      stats: {
        totalKills: 0,
        totalRuns: 0,
        boss100Defeated: false
      }
    };
  }

  function migrateSaveData(raw) {
    const base = createDefaultSave();
    if (!raw || typeof raw !== "object") return base;
    // 将来のバージョンアップ時のマイグレーション処理用フック
    const merged = {
      ...base,
      ...raw,
      equipped: { ...base.equipped, ...(raw.equipped || {}) },
      permUpgrades: { ...base.permUpgrades, ...(raw.permUpgrades || {}) },
      bestiary: { ...(raw.bestiary || {}) },
      stats: { ...base.stats, ...(raw.stats || {}) },
      ownedEquipment: Array.isArray(raw.ownedEquipment) ? Array.from(new Set([...base.ownedEquipment, ...raw.ownedEquipment])) : base.ownedEquipment,
      achievements: Array.isArray(raw.achievements) ? raw.achievements : [],
      unlockedCompanions: Array.isArray(raw.unlockedCompanions) ? raw.unlockedCompanions : [],
      version: CURRENT_SAVE_VERSION
    };
    return merged;
  }

  const SaveManager = {
    data: createDefaultSave(),
    load() {
      try {
        const rawStr = localStorage.getItem(SAVE_KEY);
        if (rawStr) {
          const parsed = JSON.parse(rawStr);
          this.data = migrateSaveData(parsed);
        } else {
          this.data = createDefaultSave();
        }
      } catch (e) {
        console.warn("Save load failed, using default:", e);
        this.data = createDefaultSave();
      }
    },
    save() {
      try {
        this.data.version = CURRENT_SAVE_VERSION;
        localStorage.setItem(SAVE_KEY, JSON.stringify(this.data));
      } catch (e) {
        console.warn("Save write failed:", e);
      }
    },
    resetAll() {
      this.data = createDefaultSave();
      this.save();
    }
  };

