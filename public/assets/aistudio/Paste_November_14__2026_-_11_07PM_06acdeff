  // バーチャルジョイスティック (Pointer EventsでPCタッチ/スマホ両対応)
  const joyArea = document.getElementById("joystickArea");
  const joyKnob = document.getElementById("joystickKnob");
  let joyPointerId = null;

  function updateJoystickFromPointer(clientX, clientY) {
    const rect = joyArea.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const maxR = rect.width * 0.42;
    let dx = clientX - cx;
    let dy = clientY - cy;
    const d = Math.hypot(dx, dy);
    if (d > maxR) {
      dx = (dx / d) * maxR;
      dy = (dy / d) * maxR;
    }
    joyKnob.style.transform = `translate(${dx}px, ${dy}px)`;
    Input.joyX = dx / maxR;
    Input.joyY = dy / maxR;
  }

  function resetJoystick() {
    joyPointerId = null;
    Input.joyActive = false;
    Input.joyX = 0;
    Input.joyY = 0;
    joyKnob.style.transform = "translate(0px, 0px)";
  }

  joyArea.addEventListener("pointerdown", (e) => {
    e.preventDefault();
    joyPointerId = e.pointerId;
    joyArea.setPointerCapture(e.pointerId);
    Input.joyActive = true;
    updateJoystickFromPointer(e.clientX, e.clientY);
  });

  joyArea.addEventListener("pointermove", (e) => {
    if (e.pointerId !== joyPointerId) return;
    updateJoystickFromPointer(e.clientX, e.clientY);
  });

  joyArea.addEventListener("pointerup", (e) => {
    if (e.pointerId === joyPointerId) resetJoystick();
  });
  joyArea.addEventListener("pointercancel", (e) => {
    if (e.pointerId === joyPointerId) resetJoystick();
  });

